  "keyFeatures": [
    "Unified contact record shared across auth, email, and SMS",
    "Single consent system covering both email and SMS channels",
    "Spending cap enforced before any message is queued (hard 402 stop)",
    "Live and test environments created automatically at account signup",
    "Every operation reachable via REST, MCP, TypeScript SDK, CLI, or dashboard",
    "Email and SMS automations with branching, wait steps, and property logic",
    "Social sign-in (Google, Microsoft, GitHub), passkeys, magic links, and email codes",
    "Idempotency keys on all mutating endpoints to prevent double-sends",
    "Hosted sign-in and preference pages with customizable theme tokens",
    "Webhook delivery with HMAC signatures and automatic retry schedule"
  ],
  "publicApiSurface": [
    "POST /v1/account/signup",
    "POST /v1/auth/* (67 operations: sign-in codes, magic links, passwords, passkeys, OAuth, sessions, organizations)",
    "POST /v1/email/send",
    "POST /v1/email/template/set + publish",
    "POST /v1/email/automation/create + update",
    "POST /v1/email/broadcast/create + send",
    "POST /v1/sms/send",
    "POST /v1/sms/template/set + publish",
    "POST /v1/audience/contact/create + update",
    "POST /v1/audience/consent/grant + revoke",
    "POST /v1/audience/segment/create",
    "POST /v1/developers/key/create + list",
    "POST /v1/developers/webhook/create + list",
    "POST /v1/billing/cap/set",
    "POST /v1/account/theme/set + publish",
    "@trylath/sdk (TypeScript/Node SDK)",
    "@trylath/react (React component library)",
    "MCP server at /v1/mcp"
  ]
}
